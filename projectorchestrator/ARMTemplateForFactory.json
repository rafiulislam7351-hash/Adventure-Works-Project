		{
			"name": "[concat(parameters('factoryName'), '/Gold')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "metadata",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "goldlayeradvw-WorkspaceDefaultSqlServer",
							"type": "LinkedServiceReference",
							"parameters": {
								"DBName": "gold"
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "-- Step 1: Create Master Key if it does not exist\nIF NOT EXISTS (SELECT * FROM sys.symmetric_keys WHERE name = '##MS_DatabaseMasterKey##')\nBEGIN\n    CREATE MASTER KEY ENCRYPTION BY PASSWORD = 'rafiul735150@#';\nEND;\n\n-- Step 2: Create Database Scoped Credential if it does not exist\nIF NOT EXISTS (SELECT * FROM sys.database_scoped_credentials WHERE name = 'advwrk')\nBEGIN\n    CREATE DATABASE SCOPED CREDENTIAL advwrk\n    WITH IDENTITY = 'Managed Identity';\nEND;\n\n-- Step 3: Create External Data Source if it does not exist\nIF NOT EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'SilverData')\nBEGIN\n    CREATE EXTERNAL DATA SOURCE SilverData\n    WITH (\n        LOCATION = 'https://advwprojectstorage.blob.core.windows.net/silver',\n        CREDENTIAL = advwrk\n    );\nEND;\n\n-- Step 1: Create Master Key if it does not exist\nIF NOT EXISTS (SELECT * FROM sys.symmetric_keys WHERE name = '##MS_DatabaseMasterKey##')\nBEGIN\n    CREATE MASTER KEY ENCRYPTION BY PASSWORD = 'rafiul735150@#';\nEND;\n\n-- Step 2: Create Database Scoped Credential if it does not exist\nIF NOT EXISTS (SELECT * FROM sys.database_scoped_credentials WHERE name = 'advwrk')\nBEGIN\n    CREATE DATABASE SCOPED CREDENTIAL advwrk\n    WITH IDENTITY = 'Managed Identity';\nEND;\n\n-- Step 3: Create External Data Source if it does not exist\nIF NOT EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'GoldData')\nBEGIN\n    CREATE EXTERNAL DATA SOURCE GoldData\n    WITH (\n        LOCATION = 'https://advwprojectstorage.blob.core.windows.net/gold',\n        CREDENTIAL = advwrk\n    );\nEND;"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Views",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "goldlayeradvw-WorkspaceDefaultSqlServer",
							"type": "LinkedServiceReference",
							"parameters": {
								"DBName": "gold"
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "-- 1. Create an External Data Source pointing to your Silver container\nIF NOT EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'SilverData')\nBEGIN\n    CREATE EXTERNAL DATA SOURCE SilverData\n    WITH (\n        LOCATION = 'https://advwprojectstorage.blob.core.windows.net/silver'\n    );\nEND;\nGO\n\n-- ==================================================\n-- 3. Views (Dimension & Fact Layers)\n-- ==================================================\n\n-- Customer\nCREATE OR ALTER VIEW Dim_Customer AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'customer/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [Customer];\nGO\n\n-- Product\nCREATE OR ALTER VIEW Dim_Product AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'product/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [Product];\nGO\n\n-- Product Category\nCREATE OR ALTER VIEW Dim_ProductCategory AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'productcategory/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [ProductCat];\nGO\n\n-- Product SubCategory\nCREATE OR ALTER VIEW Dim_ProductSubCategory AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'productsubcategory/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [ProductSubCat];\nGO\n\n-- Territories\nCREATE OR ALTER VIEW Dim_Territories AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'territories/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [Territories];\nGO\n\n-- Calendar\nCREATE OR ALTER VIEW Dim_Calendar AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'calender/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [Calendar];\nGO\n\n-- Returns\nCREATE OR ALTER VIEW Fact_Returns AS\nSELECT *\nFROM OPENROWSET(\n    BULK 'returns/',\n    DATA_SOURCE = 'SilverData',\n    FORMAT = 'PARQUET'\n) AS [Returns];\nGO\n\n-- Unified Sales Fact View (Combines 2015, 2016, 2017)\nCREATE OR ALTER VIEW Fact_Sales AS\nSELECT *, 2015 AS SalesYear FROM OPENROWSET(BULK 'sales2015/', DATA_SOURCE = 'SilverData', FORMAT = 'PARQUET') AS [S15]\nUNION ALL\nSELECT *, 2016 AS SalesYear FROM OPENROWSET(BULK 'sales2016/', DATA_SOURCE = 'SilverData', FORMAT = 'PARQUET') AS [S16]\nUNION ALL\nSELECT *, 2017 AS SalesYear FROM OPENROWSET(BULK 'sales2017/', DATA_SOURCE = 'SilverData', FORMAT = 'PARQUET') AS [S17];\nGO"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "External table",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Views",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "goldlayeradvw-WorkspaceDefaultSqlServer",
							"type": "LinkedServiceReference",
							"parameters": {
								"DBName": "gold"
							}
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "-- ==================================================\n-- 4. External Tables Creation (Gold Layer with 'Ext' Prefix & GoldData Source)\n-- ==================================================\n\n-- 1. Customer\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtCustomer'))\n    DROP EXTERNAL TABLE gold.ExtCustomer;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtCustomer\nWITH (\n    LOCATION = 'customer/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Dim_Customer;\nGO\n\n-- 2. Product\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtProduct'))\n    DROP EXTERNAL TABLE gold.ExtProduct;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtProduct\nWITH (\n    LOCATION = 'product/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Dim_Product;\nGO\n\n-- 3. Product Category\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtProductCategory'))\n    DROP EXTERNAL TABLE gold.ExtProductCategory;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtProductCategory\nWITH (\n    LOCATION = 'productcategory/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Dim_ProductCategory;\nGO\n\n-- 4. Product SubCategory\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtProductSubCategory'))\n    DROP EXTERNAL TABLE gold.ExtProductSubCategory;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtProductSubCategory\nWITH (\n    LOCATION = 'productsubcategory/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Dim_ProductSubCategory;\nGO\n\n-- 5. Territories\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtTerritories'))\n    DROP EXTERNAL TABLE gold.ExtTerritories;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtTerritories\nWITH (\n    LOCATION = 'territories/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Dim_Territories;\nGO\n\n-- 6. Calendar\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtCalendar'))\n    DROP EXTERNAL TABLE gold.ExtCalendar;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtCalendar\nWITH (\n    LOCATION = 'calendar/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Dim_Calendar;\nGO\n\n-- 7. Returns\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtReturns'))\n    DROP EXTERNAL TABLE gold.ExtReturns;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtReturns\nWITH (\n    LOCATION = 'returns/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Fact_Returns;\nGO\n\n-- 8. Sales\nIF EXISTS (SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('gold.ExtSales'))\n    DROP EXTERNAL TABLE gold.ExtSales;\nGO\n\nCREATE EXTERNAL TABLE gold.ExtSales\nWITH (\n    LOCATION = 'sales/',\n    DATA_SOURCE = GoldData,\n    FILE_FORMAT = SynapseParquetFormat\n)\nAS \nSELECT * FROM gold.Fact_Sales;\nGO"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/goldlayeradvw-WorkspaceDefaultSqlServer')]"
			]
